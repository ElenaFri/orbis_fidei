# === PostgreSQL ===
POSTGRES_USER=orbis
POSTGRES_PASSWORD=orbis
POSTGRES_DB=orbis_fidei
POSTGRES_PORT=5432
DATABASE_URL=postgresql://orbis:orbis@localhost:5432/orbis_fidei?schema=public

# === Redis ===
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# === API ===
API_HOST=0.0.0.0
API_PORT=3001
API_LOG_LEVEL=info
API_CORS_ORIGIN=http://localhost:5173

# === Auth (set properly before first production deploy) ===
JWT_ACCESS_SECRET=change-me-in-prod
JWT_REFRESH_SECRET=change-me-in-prod-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# === Seed: dev admin (do not use in production) ===
# SEED_ADMIN_EMAIL=admin@orbisfidei.local
# SEED_ADMIN_PASSWORD=ChangeMe123!

# === Web ===
VITE_API_URL=http://localhost:3001

# === AI (workers) — to be configured later ===
# AI_PROVIDER=openai
# AI_API_KEY=

# === Aggregator worker ===
AGGREGATOR_POLL_INTERVAL_MS=900000
