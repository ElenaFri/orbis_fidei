{
  "name": "orbis-fidei",
  "version": "0.0.0",
  "private": true,
  "description": "Portail international d'actualités religieuses (FR/EN/RU)",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"**/*.{ts,tsx,vue,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,vue,js,json,md,yml,yaml}\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:migrate": "pnpm --filter @orbis-fidei/database migrate",
    "db:reset": "pnpm --filter @orbis-fidei/database reset",
    "db:seed": "pnpm --filter @orbis-fidei/database seed",
    "db:studio": "pnpm --filter @orbis-fidei/database studio",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,tsx,vue,js}": [
      "eslint --fix"
    ],
    "packages/database/prisma/schema.prisma": [
      "pnpm --filter @orbis-fidei/database exec prisma format"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.0.5",
    "eslint": "^9.10.0",
    "eslint-plugin-vue": "^9.28.0",
    "globals": "^15.9.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.4.0",
    "vitest": "^2.0.5",
    "vue-eslint-parser": "^9.4.3"
  }
}
