{
  "name": "@orbis-fidei/aggregator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "aggregate:once": "tsx src/runOnce.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@orbis-fidei/config": "workspace:*",
    "@orbis-fidei/database": "workspace:*",
    "@orbis-fidei/queue": "workspace:*",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
